# ───────── Go ─────────
/rclone-sync
# Build / cache
*.db
*.db-shm
*.db-wal
rcd.log
*.pid
vendor/

# ───────── Node (now under frontend/) ─────────
frontend/node_modules/

# ───────── Python (legacy — safe to keep until full history purge) ─────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ───────── Editors / OS ─────────
.vscode/
.DS_Store

# ───────── Env / secrets ─────────
.env
.env.local

# ───────── Release artifacts ─────────
# dist/* 全忽略，但保留前端占位 dist/web/.gitkeep —— go:embed all:dist/web
# 在零匹配时编译失败，占位保证全新 checkout 可编译（产物由 make release 重建）。
dist/*
!dist/web/
dist/web/*
!dist/web/.gitkeep

# Local temp test data
*.tmp
