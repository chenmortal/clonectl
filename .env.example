DATABASE_URL=sqlite:///./clonectl.db
# MySQL 用 Go DSN 写法（凭据里的 @ # 等字符原样填写，无需转义）:
# DATABASE_URL=user:pass@tcp(host:3306)/clonectl

# rclone 单一地址：
#   RCLONE_MANAGED=true  → rcd 监听地址（0.0.0.0 = 对局域网开放），
#                          拨号地址自动派生（0.0.0.0 → 127.0.0.1）
#   RCLONE_MANAGED=false → 仅作拨号地址，指向外部 rcd，可带 http(s):// 前缀
RCLONE_RC_ADDR=0.0.0.0:5572
RCLONE_RC_USER=admin
RCLONE_RC_PASS=6051
RCLONE_MANAGED=true
RCLONE_BIN=rclone
# 启用后会从 GitHub 下载 rclone WebGUI；内网环境保持 false（控制台已有前端）。
RCLONE_RC_WEB_GUI=false
POLL_INTERVAL_SECONDS=10
CHECK_TIMEOUT_SECONDS=3600
API_HOST=0.0.0.0
API_PORT=8000
PID_FILE=clonectl.pid
# 应用日志级别: DEBUG / INFO / WARN / ERROR（未知值回退 INFO）
LOG_LEVEL=INFO
# 磁盘静态目录（存在 index.html 时优先于内嵌前端；开发热更新用）
STATIC_DIR=web/dist

# --- active-standby HA ---
# NODE_ID: 留空自动用 "<hostname>-<pid>"，两台机器必须不同
NODE_ID=
# 同一集群所有节点必须填同一个名字
CLUSTER_NAME=default
HEARTBEAT_INTERVAL_SECONDS=3
# 租约有效期（秒），建议 ≥ 心跳 × 3
LEASE_DURATION_SECONDS=10
# 预留
PEER_PROBE_ENABLED=false
PEERS=

# --- 鉴权 / RBAC ---
# 生产必填 32+ 随机字符: openssl rand -hex 32；HA 节点必须一致
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
BCRYPT_ROUNDS=12
# 首次部署填这两项，启动时若 users 表为空则自动创建 admin（幂等）
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- 告警 ---
# Alertmanager v4 webhook 默认值（可在系统设置里修改；空=禁用）
ALERTMANAGER_URL=
