DATABASE_URL=sqlite:///./rclone_sync.db
RCLONE_RC_URL=http://localhost:5572
RCLONE_RC_USER=admin
RCLONE_RC_PASS=6051
RCLONE_MANAGED=true
RCLONE_BIN=rclone
RCLONE_RC_ADDR=0.0.0.0:5572
POLL_INTERVAL_SECONDS=10
API_HOST=0.0.0.0
API_PORT=8000
PID_FILE=rclone-sync.pid
# 应用日志级别:CRITICAL / ERROR / WARNING / INFO / DEBUG。
# 调试时改成 DEBUG 可以看到 app.* 里所有 logger.debug() 输出;
# APScheduler 的心跳刷屏仍然被显式静默到 WARNING,不会因为这里设成 DEBUG 就一起爆。
LOG_LEVEL=INFO

# --- active-standby HA ---
# NODE_ID: 留空则 LeaderElector 自动用 "<hostname>-<pid>"
# 两台机器必须不同,否则选举会出现 split-brain 的诊断困扰。
NODE_ID=
# 同一集群的所有节点必须填同一个名字,选举表以这个字段分组。
CLUSTER_NAME=default
# 选举心跳周期(秒);lease 续约和 liveness 写都用这个频率。
HEARTBEAT_INTERVAL_SECONDS=3
# 租约有效期(秒);建议 ≥ 心跳 × 3,容忍一次抖动。建议范围:6-30。
LEASE_DURATION_SECONDS=10
# 预留:peer HTTP /healthz 探测,关闭可避免跨网络分区时的双判定。
PEER_PROBE_ENABLED=false
# 预留:逗号分隔的 peer URL 列表,供 status / 未来探测使用。
PEERS=

# --- 鉴权 / RBAC ---
# JWT_SECRET: 必须 32+ 随机字符,所有 HA 节点必须共享同一个 secret。
# 生成: openssl rand -hex 32
# 留空会落到内置占位符 "CHANGE-ME-IN-PRODUCTION",启动时打 WARNING 但不阻塞。
JWT_SECRET=
JWT_ALGORITHM=HS256
# access token 有效期(分钟),默认 8 小时。
JWT_EXPIRES_MINUTES=480
# bcrypt cost factor,12 ≈ 250ms 每次 hash;调高会更慢更安全。
BCRYPT_ROUNDS=12
# 首次部署时填这两个,启动后会自动创建一个 admin 账号。后续保留/修改都安全(幂等)。
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD='6051'
